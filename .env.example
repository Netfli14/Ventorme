# Registration attribution is pinned to official team 004 in src/lib/config.ts.
# Optional on Vercel: production origin is detected automatically. Use HTTPS, no trailing slash.
NEXT_PUBLIC_SITE_URL=
# Existing private Vercel Blob store (reuse the click counter store):
# BLOB_STORE_ID=  or BLOB_READ_WRITE_TOKEN= (server only)
# Generate these locally with: node scripts/configure-admin.mjs
VENTORME_ADMIN_PASSWORD_HASH=
VENTORME_SESSION_SECRET=
# Optional local E2E adapter, disabled in production and on Vercel:
# VENTORME_LOCAL_DATA_DIR=/absolute/path/to/private-test-data
